{
  "name": "slidev-tum-workspace",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "slidev examples/showcase/slides.md --open",
    "dev:starter": "slidev examples/starter/slides.md --open",
    "build": "pnpm run build:package && pnpm run build:examples",
    "build:package": "pnpm --filter slidev-theme-tum pack --pack-destination dist",
    "build:examples": "slidev build examples/showcase/slides.md --out ../../dist/showcase && slidev build examples/starter/slides.md --out ../../dist/starter",
    "export": "slidev export examples/showcase/slides.md --output dist/showcase.pdf",
    "lint": "pnpm run lint:js && pnpm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"theme/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"theme/**/*.css\" --fix",
    "lint:actions": "actionlint && zizmor .github",
    "lint:secrets": "gitleaks git --no-banner --redact",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "bash scripts/smoke-test-package.sh dist/slidev-theme-tum-*.tgz",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "docs:screens": "node scripts/docs-screenshots.js",
    "docs:dev": "pnpm run docs:screens && zensical serve",
    "docs:build": "pnpm run docs:screens && zensical build --clean --strict",
    "release": "release-it"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@release-it/conventional-changelog": "^12.0.0",
    "@slidev/cli": "^53.1.0",
    "@slidev/client": "^53.1.0",
    "@slidev/parser": "53.1.0",
    "@slidev/types": "^53.1.0",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.0.0",
    "happy-dom": "^21.0.0",
    "lefthook": "2.2.1",
    "playwright-chromium": "^1.65.0",
    "release-it": "^21.0.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.0"
  }
}
